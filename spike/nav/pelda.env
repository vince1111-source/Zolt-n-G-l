# Másold .env néven a spike/ mappába, töltsd ki, és NE tedd be a repóba.
# Betöltés:  set -a && . ./.env && set +a

# teszt | eles  — először mindig teszt
NAV_KORNYEZET=teszt

# A technikai felhasználó adatai (Online Számla fiók → Felhasználók → Új technikai felhasználó).
# Figyelem: ez NEM az ügyfélkapus belépés.
NAV_LOGIN=
NAV_JELSZO=

# A cég adószámának ELSŐ 8 SZÁMJEGYE, kötőjel nélkül.
NAV_ADOSZAM=

# Az aláírókulcs (XML aláírókulcs). A cserekulcs csak számlabeküldéshez kell —
# ez a projekt nem küld be számlát, ezért ide nem kell.
NAV_ALAIROKULCS=

# Szoftver-blokk. Éles használatnál a saját cégadataidat kell megadni;
# a softwareId 18 karakter hosszú, saját magad adod ki.
SW_ID=CEGEMAISPIKE000001
SW_NEV=CEGEM.AI spike
SW_FOVERZIO=0.1
SW_FEJLESZTO_NEV=
SW_FEJLESZTO_KAPCSOLAT=
SW_FEJLESZTO_ADOSZAM=
